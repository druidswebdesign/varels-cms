package partials

import (
	"fmt"

	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
)

// RestockRow is one stock movement line, shared by the restock and ledger pages.
templ RestockRow(m sqlc.StockMovement, sku string, location string) {
	<tr class="hover:bg-accent">
		<td class="px-4 py-2 text-muted-foreground">{ m.CreatedAt }</td>
		<td class="px-4 py-2">{ sku }</td>
		<td class="px-4 py-2 text-muted-foreground">{ location }</td>
		<td class="px-4 py-2">{ string(m.State) }</td>
		<td class="px-4 py-2 text-right">
			if m.QuantityDelta >= 0 {
				@components.Badge("+"+fmt.Sprint(m.QuantityDelta), "success")
			} else {
				@components.Badge(fmt.Sprint(m.QuantityDelta), "danger")
			}
		</td>
		<td class="px-4 py-2 text-muted-foreground">{ string(m.RefType) }</td>
		<td class="px-4 py-2 text-muted-foreground">{ format.NullString(m.Note) }</td>
	</tr>
}

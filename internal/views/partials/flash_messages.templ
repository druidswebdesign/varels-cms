package partials

import "github.com/yourname/varels_cms/internal/views/flash"

// FlashMessages renders one flash message (if any) inside the #flash slot.
templ FlashMessages(f flash.Flash) {
	if f.Message != "" {
		if f.Tone == "error" {
			<div role="alert" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ f.Message }</div>
		} else if f.Tone == "warning" {
			<div role="alert" class="rounded-md border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-sm text-amber-700 dark:text-amber-300">{ f.Message }</div>
		} else {
			<div role="status" class="rounded-md border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-700 dark:text-emerald-300">{ f.Message }</div>
		}
	}
}

// FlashOOB is the flash slot returned by an HTMX response so the message swaps
// out-of-band into #flash without a full page reload.
templ FlashOOB(f flash.Flash) {
	<div id="flash" hx-swap-oob="true" class="mb-4">
		@FlashMessages(f)
	</div>
}

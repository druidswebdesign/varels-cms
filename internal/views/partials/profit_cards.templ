package partials

import (
	"github.com/yourname/varels_cms/internal/views/format"
)

// ProfitCards renders the P&L summary. Admin-only (ADR-0007, ADR-0018).
templ ProfitCards(revenueMinor int64, cogsMinor int64, grossMinor int64, opexMinor int64, netMinor int64) {
	<div id="profit-cards" class="grid gap-4 sm:grid-cols-3">
		@profitCard("Revenue", format.Money(revenueMinor), "neutral")
		@profitCard("Gross profit", format.Money(grossMinor), "info")
		@profitCard("Net profit", format.Money(netMinor), toneFor(netMinor))
		@profitCard("COGS", format.Money(cogsMinor), "neutral")
		@profitCard("OpEx", format.Money(opexMinor), "neutral")
		@profitCard("Gross margin", format.PercentOf(grossMinor, revenueMinor), "neutral")
	</div>
}

templ profitCard(label string, value string, tone string) {
	<div class="rounded-lg border border-gray-200 bg-white p-4">
		<p class="text-sm text-gray-500">{ label }</p>
		<p class="mt-1 text-2xl font-semibold { valueClass(tone) }">{ value }</p>
	</div>
}

func toneFor(v int64) string {
	if v < 0 {
		return "danger"
	}
	return "success"
}

func valueClass(tone string) string {
	switch tone {
	case "success":
		return "text-green-700"
	case "danger":
		return "text-red-600"
	case "info":
		return "text-blue-700"
	default:
		return "text-gray-900"
	}
}

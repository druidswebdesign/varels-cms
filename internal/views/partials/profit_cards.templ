package partials

import (
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
)

// ProfitCards renders the P&L summary. Admin-only (ADR-0007, ADR-0018).
templ ProfitCards(revenueMinor int64, cogsMinor int64, grossMinor int64, opexMinor int64, netMinor int64) {
	<div id="profit-cards" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		@components.StatCard("Revenue", format.Money(revenueMinor), "neutral")
		@components.StatCard("Gross profit", format.Money(grossMinor), "info")
		@components.StatCard("Net profit", format.Money(netMinor), toneFor(netMinor))
		@components.StatCard("COGS", format.Money(cogsMinor), "neutral")
		@components.StatCard("OpEx", format.Money(opexMinor), "neutral")
		@components.StatCard("Gross margin", format.PercentOf(grossMinor, revenueMinor), "neutral")
	</div>
}

func toneFor(v int64) string {
	if v < 0 {
		return "danger"
	}
	return "success"
}

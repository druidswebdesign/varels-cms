package partials

import (
	"fmt"

	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
)

// DeadstockTable lists variants with no sales in the stale window.
templ DeadstockTable(rows []sqlc.DeadstockRow, totalTrappedMinor int64, staleDays int) {
	<div id="deadstock-table">
		<p class="mb-3 text-sm text-muted-foreground">
			Trapped cash: <span class="font-semibold text-foreground">{ format.Money(totalTrappedMinor) }</span>
			· no sales in { fmt.Sprint(staleDays) } days
		</p>
		@components.Table() {
			<thead class="bg-muted">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Product</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">SKU</th>
					<th class="px-4 py-2 text-right font-medium text-muted-foreground">On hand</th>
					<th class="px-4 py-2 text-right font-medium text-muted-foreground">Trapped cash</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				if len(rows) == 0 {
					<tr><td colspan="4" class="px-4 py-8 text-center text-muted-foreground">Nothing stale. Good.</td></tr>
				}
				for _, r := range rows {
					<tr>
						<td class="px-4 py-2">{ r.ProductName }</td>
						<td class="px-4 py-2 font-mono text-xs text-muted-foreground">{ r.Sku }</td>
						<td class="px-4 py-2 text-right">{ fmt.Sprint(r.QtyOnHand) }</td>
						<td class="px-4 py-2 text-right font-medium">{ format.Money(r.TrappedCashMinor) }</td>
					</tr>
				}
			</tbody>
		}
	</div>
}

package partials

import (
	"fmt"

	"github.com/yourname/varels_cms/internal/views/vm"
)

// SizeCurve renders best-selling sizes (sizing curve for next PO).
templ SizeCurve(rows []vm.SizeRow) {
	<div id="size-curve" class="rounded-lg border border-gray-200 bg-white p-4"
		hx-get="/analytics/sizes" hx-trigger="change from:#year, change from:#month"
		hx-include="#year,#month" hx-swap="outerHTML">
		<h2 class="mb-3 text-sm font-medium text-gray-700">Size curve</h2>
		if len(rows) == 0 {
			<p class="text-sm text-gray-500">No sales in this period.</p>
		} else {
			<ul class="space-y-2 text-sm">
				for _, r := range rows {
					<li class="flex items-center justify-between">
						<span>{ r.Size }</span>
						<span class="text-gray-500">{ fmt.Sprint(r.UnitsSold) } units</span>
					</li>
				}
			</ul>
		}
	</div>
}

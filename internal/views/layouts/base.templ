package layouts

import (
	"github.com/yourname/varels_cms/internal/views/components"
	"github.com/yourname/varels_cms/internal/views/flash"
	"github.com/yourname/varels_cms/internal/views/partials"
)

// Base is the full-page shell: shadcn-style sidebar + sticky header, HTMX,
// Alpine, ApexCharts and the compiled Tailwind stylesheet. Every page renders
// inside it. `active` is the sidebar key; `title` labels the current page.
templ Base(title string, active string, csrf string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · varels_cms</title>
			<script>
				(function () {
					try {
						var saved = localStorage.getItem("theme");
						var dark = saved === "dark" || (saved === null && window.matchMedia("(prefers-color-scheme: dark)").matches);
						if (dark) document.documentElement.classList.add("dark");
					} catch (e) {}
				})();
			</script>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<script src="/assets/js/htmx.min.js"></script>
			<script defer src="/assets/js/alpine.min.js"></script>
			<script defer src="/assets/js/app.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
		</head>
		<body hx-headers={ `{"X-CSRF-Token":"` + csrf + `"}` } class="min-h-screen bg-background text-foreground antialiased">
			<div x-data="{ sidebarOpen: false }" class="min-h-screen">
				@components.Sidebar(active)
				<div class="flex min-h-screen flex-col lg:pl-64">
					@components.Navbar(title, csrf)
					<main class="flex-1 px-4 py-6 lg:px-8">
						<div id="flash" class="mb-4">
							@partials.FlashMessages(flash.Get(ctx))
						</div>
						{ children... }
					</main>
				</div>
			</div>
		</body>
	</html>
}

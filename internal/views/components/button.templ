package components

// Button renders a submit button. kind is one of: primary, secondary, danger.
templ Button(label string, kind string) {
	if kind == "secondary" {
		<button type="submit" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">{ label }</button>
	} else if kind == "danger" {
		<button type="submit" class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-500">{ label }</button>
	} else {
		<button type="submit" class="rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700">{ label }</button>
	}
}

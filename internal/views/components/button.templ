package components

// Button renders a submit button. kind is one of: primary, secondary, danger.
templ Button(label string, kind string) {
	if kind == "secondary" {
		<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">{ label }</button>
	} else if kind == "danger" {
		<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md bg-destructive px-4 py-2 text-sm font-medium text-destructive-foreground shadow-sm transition-colors hover:bg-destructive/90">{ label }</button>
	} else {
		<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">{ label }</button>
	}
}

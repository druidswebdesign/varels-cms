package components

// Flash renders a single flash message. kind is one of: success, error, info.
templ Flash(kind string, message string) {
	if kind == "success" {
		<div role="status" class="rounded-md border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-700 dark:text-emerald-300">{ message }</div>
	} else if kind == "error" {
		<div role="alert" class="rounded-md border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ message }</div>
	} else {
		<div role="status" class="rounded-md border border-blue-500/30 bg-blue-500/10 px-4 py-3 text-sm text-blue-700 dark:text-blue-300">{ message }</div>
	}
}

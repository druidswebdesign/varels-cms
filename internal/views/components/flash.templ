package components

// Flash renders a single flash message. kind is one of: success, error, info.
templ Flash(kind string, message string) {
	if kind == "success" {
		<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{ message }</div>
	} else if kind == "error" {
		<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{ message }</div>
	} else {
		<div class="rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">{ message }</div>
	}
}

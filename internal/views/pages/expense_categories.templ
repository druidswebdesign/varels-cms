package pages

import (
	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
)

// ExpenseCategories lists OpEx categories and offers the create form.
templ ExpenseCategories(categories []sqlc.ExpenseCategory, csrf string) {
	@layouts.Base("Expense categories", "expenses", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Expense categories</h1>
			<a href="/expenses" class="text-sm text-muted-foreground hover:text-foreground">Back to expenses</a>
		</div>

		<form method="post" action="/expense-categories"
			class="mb-6 flex flex-wrap items-end gap-3 rounded-lg border border-border bg-card p-4">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div>
				<label for="name" class="mb-1 block text-xs font-medium text-muted-foreground">Name</label>
				<input id="name" name="name" type="text" required class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Add category</button>
		</form>

		@components.Table() {
			<thead class="bg-muted">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Name</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				if len(categories) == 0 {
					<tr><td class="px-4 py-8 text-center text-muted-foreground">No categories yet.</td></tr>
				}
				for _, c := range categories {
					<tr class="hover:bg-accent">
						<td class="px-4 py-2 font-medium text-foreground">{ c.Name }</td>
					</tr>
				}
			</tbody>
		}
	}
}

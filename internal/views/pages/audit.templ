package pages

import (
	"fmt"

	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
)

// Audit renders the append-only audit trail with filters (ADR-0010).
templ Audit(logs []sqlc.AuditLog, user, entity, from, to, csrf string) {
	@layouts.Base("Audit log", "audit", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Audit log</h1>
			<a href="/audit" class="text-sm text-muted-foreground hover:text-foreground">Clear filters</a>
		</div>

		<form method="get" action="/audit" class="mb-4 flex flex-wrap items-end gap-3">
			<div>
				<label for="user" class="mb-1 block text-xs font-medium text-muted-foreground">User ID</label>
				<input id="user" name="user" type="number" value={ user } class="w-24 rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="entity" class="mb-1 block text-xs font-medium text-muted-foreground">Entity type</label>
				<input id="entity" name="entity" type="text" value={ entity } placeholder="order" class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="from" class="mb-1 block text-xs font-medium text-muted-foreground">From</label>
				<input id="from" name="from" type="date" value={ from } class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="to" class="mb-1 block text-xs font-medium text-muted-foreground">To</label>
				<input id="to" name="to" type="date" value={ to } class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="rounded-md border border-input bg-card px-3 py-2 text-sm hover:bg-accent">Filter</button>
		</form>

		@components.Table() {
			<thead class="bg-muted">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">When</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">User</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Action</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Entity</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Note</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">IP</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				if len(logs) == 0 {
					<tr><td colspan="6" class="px-4 py-8 text-center text-muted-foreground">No audit entries found.</td></tr>
				}
				for _, l := range logs {
					<tr class="hover:bg-accent">
						<td class="px-4 py-2 text-muted-foreground">{ l.CreatedAt }</td>
						<td class="px-4 py-2 text-muted-foreground">
							if l.UserID.Valid {
								{ fmt.Sprint(l.UserID.Int64) }
							} else {
								<span class="text-muted-foreground">system</span>
							}
						</td>
						<td class="px-4 py-2">
							@components.Badge(l.Action, "info")
						</td>
						<td class="px-4 py-2 text-foreground">
							{ l.EntityType }
							if l.EntityID.Valid {
								<span class="text-muted-foreground">#{ fmt.Sprint(l.EntityID.Int64) }</span>
							}
						</td>
						<td class="px-4 py-2 text-muted-foreground">{ format.NullString(l.Note) }</td>
						<td class="px-4 py-2 text-muted-foreground">{ format.NullString(l.Ip) }</td>
					</tr>
				}
			</tbody>
		}
	}
}

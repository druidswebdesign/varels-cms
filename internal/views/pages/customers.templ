package pages

import (
	"fmt"

	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
)

// Customers lists customer profiles with a search box and create form.
templ Customers(customers []sqlc.Customer, q string, csrf string) {
	@layouts.Base("Customers", "customers", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Customers</h1>
		</div>

		<form method="post" action="/customers"
			class="mb-6 flex flex-wrap items-end gap-3 rounded-lg border border-gray-200 bg-white p-4">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div>
				<label for="name" class="mb-1 block text-xs font-medium text-gray-600">Name</label>
				<input id="name" name="name" type="text" required class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="phone" class="mb-1 block text-xs font-medium text-gray-600">Phone</label>
				<input id="phone" name="phone" type="text" class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="email" class="mb-1 block text-xs font-medium text-gray-600">Email</label>
				<input id="email" name="email" type="email" class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="instagram" class="mb-1 block text-xs font-medium text-gray-600">Instagram</label>
				<input id="instagram" name="instagram" type="text" class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">Add customer</button>
		</form>

		<form method="get" action="/customers" class="mb-4 flex flex-wrap items-center gap-3">
			<input type="search" name="q" value={ q } placeholder="Search name, phone or email"
				class="w-64 rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			<button type="submit" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm hover:bg-gray-50">Search</button>
			if q != "" {
				<a href="/customers" class="text-sm text-gray-500 hover:text-gray-700">Clear</a>
			}
		</form>

		@components.Table() {
			<thead class="bg-gray-50">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Name</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Phone</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Email</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Instagram</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-100">
				if len(customers) == 0 {
					<tr><td colspan="4" class="px-4 py-8 text-center text-gray-500">No customers found.</td></tr>
				}
				for _, c := range customers {
					<tr class="hover:bg-gray-50">
						<td class="px-4 py-2 font-medium text-gray-900">
							<a href={ "/customers/" + fmt.Sprint(c.ID) } class="hover:underline">{ c.Name }</a>
						</td>
						<td class="px-4 py-2 text-gray-500">{ format.NullString(c.Phone) }</td>
						<td class="px-4 py-2 text-gray-500">{ format.NullString(c.Email) }</td>
						<td class="px-4 py-2 text-gray-500">{ format.NullString(c.Instagram) }</td>
					</tr>
				}
			</tbody>
		}
	}
}

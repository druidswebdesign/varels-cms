package pages

import (
	"fmt"

	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
)

// SaleDetail is the receipt / order detail page.
templ SaleDetail(data SaleDetailData, csrf string) {
	@layouts.Base("Sale "+data.Order.OrderNumber, "sales", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<div>
				<div class="flex items-center gap-2">
					<h1 class="text-xl font-semibold">{ data.Order.OrderNumber }</h1>
					if data.Order.Status == "cancelled" {
						@components.Badge(string(data.Order.Status), "danger")
					} else if data.Order.Status == "returned" {
						@components.Badge(string(data.Order.Status), "warning")
					} else {
						@components.Badge(string(data.Order.Status), "success")
					}
				</div>
				<p class="text-sm text-gray-500">{ data.Order.PlacedAt } · { data.Channel } · { data.Location } · { data.Customer }</p>
			</div>
			<div class="flex items-center gap-3">
				if data.Order.Status != "cancelled" && data.Order.Status != "returned" {
					<a href={ "/sales/" + fmt.Sprint(data.Order.ID) + "/return" } class="text-sm text-gray-600 hover:text-gray-900">Return</a>
				}
				if data.Order.Status != "cancelled" {
					<form method="post" action={ "/sales/" + fmt.Sprint(data.Order.ID) + "/void" }>
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<button type="submit" class="text-sm text-red-600 hover:text-red-800">Void</button>
					</form>
				}
				<a href="/sales" class="text-sm text-gray-500 hover:text-gray-700">Back</a>
			</div>
		</div>

		@components.Table() {
			<thead class="bg-gray-50">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Item</th>
					<th class="px-4 py-2 text-right font-medium text-gray-500">Qty</th>
					<th class="px-4 py-2 text-right font-medium text-gray-500">Unit</th>
					<th class="px-4 py-2 text-right font-medium text-gray-500">Discount</th>
					<th class="px-4 py-2 text-right font-medium text-gray-500">Line total</th>
					<th class="px-4 py-2 text-right font-medium text-gray-500">Returned</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-100">
				for _, l := range data.Lines {
					<tr>
						<td class="px-4 py-2">{ l.ProductName } <span class="text-gray-400">{ l.Size } { l.Color }</span> <span class="font-mono text-xs text-gray-400">{ l.Sku }</span></td>
						<td class="px-4 py-2 text-right">{ fmt.Sprint(l.Item.Quantity) }</td>
						<td class="px-4 py-2 text-right">{ format.Money(l.Item.UnitPriceMinor) }</td>
						<td class="px-4 py-2 text-right">{ format.Money(l.Item.DiscountMinor) }</td>
						<td class="px-4 py-2 text-right">{ format.Money(l.Item.LineTotalMinor) }</td>
						<td class="px-4 py-2 text-right">{ fmt.Sprint(l.ReturnedQty) }</td>
					</tr>
				}
			</tbody>
		}

		<div class="mt-4 grid gap-4 md:grid-cols-2">
			<div class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
				<h2 class="mb-2 font-medium text-gray-700">Totals</h2>
				<div class="flex justify-between py-1"><span class="text-gray-500">Subtotal</span><span>{ format.Money(data.Order.SubtotalMinor) }</span></div>
				<div class="flex justify-between py-1"><span class="text-gray-500">Discount</span><span>−{ format.Money(data.Order.DiscountMinor) }</span></div>
				<div class="flex justify-between py-1"><span class="text-gray-500">Shipping</span><span>{ format.Money(data.Order.ShippingMinor) }</span></div>
				<div class="flex justify-between py-1"><span class="text-gray-500">IVA (display)</span><span>{ format.Money(data.Order.TaxMinor) }</span></div>
				<div class="flex justify-between border-t border-gray-100 py-1 font-semibold"><span>Total</span><span>{ format.Money(data.Order.TotalMinor) }</span></div>
			</div>

			<div class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
				<h2 class="mb-2 font-medium text-gray-700">Payments</h2>
				if len(data.Payments) == 0 {
					<p class="text-gray-500">No payments recorded.</p>
				}
				for _, p := range data.Payments {
					<div class="flex justify-between py-1">
						<span class="text-gray-500">{ string(p.Method) } · { p.PaidAt } · { string(p.Status) }</span>
						<span>{ format.Money(p.AmountMinor) }</span>
					</div>
				}
				if data.HasCustomer {
					<div class="mt-2 flex justify-between border-t border-gray-100 py-1">
						<span class="text-gray-500">Store credit balance</span>
						<span>{ format.Money(data.StoreCredit) }</span>
					</div>
				}
				if data.Order.Status != "cancelled" {
					<form method="post" action={ "/sales/" + fmt.Sprint(data.Order.ID) + "/payments" }
						class="mt-3 flex flex-wrap items-end gap-2 border-t border-gray-100 pt-3">
						<input type="hidden" name="csrf_token" value={ csrf }/>
						<div>
							<label for="method" class="mb-1 block text-xs font-medium text-gray-600">Method</label>
							<select id="method" name="method" class="rounded-md border border-gray-300 px-2 py-1.5 text-sm">
								<option value="cash">cash</option>
								<option value="card">card</option>
								<option value="mercadopago">mercadopago</option>
								<option value="transfer">transfer</option>
								<option value="store_credit">store_credit</option>
							</select>
						</div>
						<div>
							<label for="amount" class="mb-1 block text-xs font-medium text-gray-600">Amount (ARS)</label>
							<input id="amount" name="amount" type="number" min="0" step="0.01" required class="w-28 rounded-md border border-gray-300 px-2 py-1.5 text-sm"/>
						</div>
						<div>
							<label for="reference" class="mb-1 block text-xs font-medium text-gray-600">Reference</label>
							<input id="reference" name="reference" type="text" class="w-32 rounded-md border border-gray-300 px-2 py-1.5 text-sm"/>
						</div>
						<button type="submit" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-50">Add payment</button>
					</form>
				}
			</div>
		</div>

		if len(data.Returns) > 0 {
			<h2 class="mb-2 mt-6 text-lg font-semibold">Returns</h2>
			@components.Table() {
				<thead class="bg-gray-50">
					<tr>
						<th class="px-4 py-2 text-left font-medium text-gray-500">When</th>
						<th class="px-4 py-2 text-left font-medium text-gray-500">Resolution</th>
						<th class="px-4 py-2 text-left font-medium text-gray-500">Status</th>
						<th class="px-4 py-2 text-right font-medium text-gray-500">Refund</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					for _, ret := range data.Returns {
						<tr>
							<td class="px-4 py-2 text-gray-500">{ ret.CreatedAt }</td>
							<td class="px-4 py-2">{ string(ret.Resolution) }</td>
							<td class="px-4 py-2">{ string(ret.Status) }</td>
							<td class="px-4 py-2 text-right">{ format.Money(ret.TotalRefundMinor) }</td>
						</tr>
					}
				</tbody>
			}
		}
	}
}

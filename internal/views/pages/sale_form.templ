package pages

import (
	"fmt"

	"github.com/yourname/varels_cms/internal/db/sqlc"
	"github.com/yourname/varels_cms/internal/views/layouts"
)

// SaleForm is the point-of-sale checkout. The line editor and running total are
// an Alpine.js component (`pos()` in assets/js/app.js); submitted fields keep
// their repeated names (variant_id, quantity, unit_price, line_discount) so the
// handler reads them as arrays.
templ SaleForm(variants []sqlc.ListSellableVariantsRow, customers []sqlc.Customer, channels []sqlc.SalesChannel, locations []sqlc.Location, csrf string, err string) {
	@layouts.Base("New sale", "sales", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">New sale</h1>
			<a href="/sales" class="text-sm text-gray-600 hover:text-gray-900">Sales</a>
		</div>

		if err != "" {
			<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{ saleErr(err) }</div>
		}

		<form method="post" action="/sales" id="sale-form" x-data="pos()" class="space-y-6">
			<input type="hidden" name="csrf_token" value={ csrf }/>

			<div class="grid gap-4 rounded-lg border border-gray-200 bg-white p-4 md:grid-cols-3">
				<div>
					<label for="customer_id" class="mb-1 block text-xs font-medium text-gray-600">Customer (optional)</label>
					<select id="customer_id" name="customer_id" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
						<option value="">— anonymous —</option>
						for _, c := range customers {
							<option value={ fmt.Sprint(c.ID) }>{ c.Name }</option>
						}
					</select>
					<input name="new_customer_name" type="text" placeholder="…or new customer name"
						class="mt-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm"/>
					<input name="new_customer_phone" type="text" placeholder="new customer phone"
						class="mt-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm"/>
				</div>
				<div>
					<label for="channel_id" class="mb-1 block text-xs font-medium text-gray-600">Channel</label>
					<select id="channel_id" name="channel_id" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
						for _, c := range channels {
							<option value={ fmt.Sprint(c.ID) }>{ c.Name }</option>
						}
					</select>
				</div>
				<div>
					<label for="location_id" class="mb-1 block text-xs font-medium text-gray-600">Location</label>
					<select id="location_id" name="location_id" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
						for _, l := range locations {
							<option value={ fmt.Sprint(l.ID) }>{ l.Name }</option>
						}
					</select>
				</div>
			</div>

			<div class="rounded-lg border border-gray-200 bg-white p-4">
				<div class="mb-2 flex items-center justify-between">
					<h2 class="text-sm font-medium text-gray-700">Items</h2>
					<button type="button" @click="addLine()" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50">Add line</button>
				</div>
				<table class="min-w-full text-sm">
					<thead>
						<tr class="text-gray-500">
							<th class="py-1 text-left font-medium">Variant</th>
							<th class="py-1 text-right font-medium">Qty</th>
							<th class="py-1 text-right font-medium">Unit price (ARS)</th>
							<th class="py-1 text-right font-medium">Discount (ARS)</th>
							<th class="py-1"></th>
						</tr>
					</thead>
					<tbody>
						<template x-for="(line, index) in lines" :key="line.key">
							<tr class="border-t border-gray-100">
								<td class="py-1 pr-2">
									<select name="variant_id" x-model="line.variant_id" @change="onVariant($event, index)"
										class="w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm">
										<option value="">— select —</option>
										for _, v := range variants {
											<option value={ fmt.Sprint(v.ID) } data-retail={ fmt.Sprint(v.RetailPriceMinor) }>{ v.ProductName } · { v.Sku }</option>
										}
									</select>
								</td>
								<td class="py-1 pr-2">
									<input name="quantity" type="number" min="1" step="1" x-model.number="line.quantity" @input="recalc()"
										class="w-20 rounded-md border border-gray-300 px-2 py-1.5 text-right text-sm"/>
								</td>
								<td class="py-1 pr-2">
									<input name="unit_price" type="number" min="0" step="0.01" x-model.number="line.unit_price" @input="recalc()"
										class="w-28 rounded-md border border-gray-300 px-2 py-1.5 text-right text-sm"/>
								</td>
								<td class="py-1 pr-2">
									<input name="line_discount" type="number" min="0" step="0.01" x-model.number="line.line_discount" @input="recalc()"
										class="w-24 rounded-md border border-gray-300 px-2 py-1.5 text-right text-sm"/>
								</td>
								<td class="py-1">
									<button type="button" @click="removeLine(index)" class="text-sm text-red-600 hover:text-red-800">×</button>
								</td>
							</tr>
						</template>
					</tbody>
				</table>
			</div>

			<div class="grid gap-4 rounded-lg border border-gray-200 bg-white p-4 md:grid-cols-4">
				<div>
					<label for="payment_method" class="mb-1 block text-xs font-medium text-gray-600">Payment</label>
					<select id="payment_method" name="payment_method" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
						<option value="cash">Cash</option>
						<option value="card">Card</option>
						<option value="mercadopago">MercadoPago</option>
						<option value="transfer">Transfer</option>
						<option value="store_credit">Store credit</option>
					</select>
				</div>
				<div>
					<label for="order_discount" class="mb-1 block text-xs font-medium text-gray-600">Order discount (ARS)</label>
					<input id="order_discount" name="order_discount" type="number" min="0" step="0.01" x-model.number="orderDiscount" @input="recalc()"
						class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"/>
				</div>
				<div>
					<label for="shipping" class="mb-1 block text-xs font-medium text-gray-600">Shipping (ARS)</label>
					<input id="shipping" name="shipping" type="number" min="0" step="0.01" x-model.number="shipping" @input="recalc()"
						class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"/>
				</div>
				<div>
					<label for="note" class="mb-1 block text-xs font-medium text-gray-600">Note</label>
					<input id="note" name="note" type="text" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm"/>
				</div>
			</div>

			<div class="flex items-center justify-between">
				<p class="text-lg font-semibold">Total: <span x-text="money(total())">$0,00</span></p>
				<button type="submit" class="rounded-md bg-gray-900 px-5 py-2 text-sm font-medium text-white hover:bg-gray-700">Complete sale</button>
			</div>
		</form>
	}
}

func saleErr(code string) string {
	switch code {
	case "lines":
		return "Add at least one line with a positive quantity."
	case "credit_customer":
		return "Store credit requires a customer on the sale."
	case "credit_balance":
		return "The customer does not have enough store credit."
	case "stock":
		return "Not enough stock for one of the lines. Nothing was saved."
	default:
		return "Invalid sale. Check channel, location and payment method."
	}
}

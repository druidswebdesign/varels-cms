package pages

import (
	"fmt"

	"github.com/yourname/varels_cms/internal/db/sqlc"
	"github.com/yourname/varels_cms/internal/views/components"
	"github.com/yourname/varels_cms/internal/views/format"
	"github.com/yourname/varels_cms/internal/views/layouts"
)

// Holds lists stock holds / reservations and offers create + release.
templ Holds(holds []sqlc.ListStockHoldsRow, variants []sqlc.ListSellableVariantsRow, locations []sqlc.Location, csrf string) {
	@layouts.Base("Stock holds", "holds", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Stock holds</h1>
		</div>

		<form method="post" action="/holds"
			class="mb-4 flex flex-wrap items-end gap-3 rounded-lg border border-gray-200 bg-white p-4">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div class="grow">
				<label for="variant_id" class="mb-1 block text-xs font-medium text-gray-600">Variant</label>
				<select id="variant_id" name="variant_id" required class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
					for _, v := range variants {
						<option value={ fmt.Sprint(v.ID) }>{ v.ProductName } · { format.NullString(v.Size) } { format.NullString(v.Color) } · { v.Sku }</option>
					}
				</select>
			</div>
			<div>
				<label for="location_id" class="mb-1 block text-xs font-medium text-gray-600">Location</label>
				<select id="location_id" name="location_id" required class="rounded-md border border-gray-300 px-3 py-2 text-sm">
					for _, l := range locations {
						<option value={ fmt.Sprint(l.ID) }>{ l.Name }</option>
					}
				</select>
			</div>
			<div>
				<label for="quantity" class="mb-1 block text-xs font-medium text-gray-600">Quantity</label>
				<input id="quantity" name="quantity" type="number" min="1" required class="w-24 rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="source" class="mb-1 block text-xs font-medium text-gray-600">Source</label>
				<select id="source" name="source" class="rounded-md border border-gray-300 px-3 py-2 text-sm">
					<option value="manual">manual</option>
					<option value="cart">cart</option>
					<option value="preorder">preorder</option>
				</select>
			</div>
			<div>
				<label for="ref_id" class="mb-1 block text-xs font-medium text-gray-600">Reference</label>
				<input id="ref_id" name="ref_id" type="text" class="w-32 rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="expires_at" class="mb-1 block text-xs font-medium text-gray-600">Expires (local)</label>
				<input id="expires_at" name="expires_at" type="datetime-local" class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">Create hold</button>
		</form>

		<form method="get" action="/holds" class="mb-4 flex items-center gap-3">
			<select name="status" class="rounded-md border border-gray-300 px-3 py-2 text-sm">
				<option value="">All statuses</option>
				<option value="active">active</option>
				<option value="released">released</option>
				<option value="consumed">consumed</option>
				<option value="expired">expired</option>
			</select>
			<button type="submit" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm hover:bg-gray-50">Filter</button>
		</form>

		@components.Table() {
			<thead class="bg-gray-50">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Created</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Variant</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Location</th>
					<th class="px-4 py-2 text-right font-medium text-gray-500">Qty</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Source</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Status</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Expires</th>
					<th class="px-4 py-2"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-100">
				if len(holds) == 0 {
					<tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">No holds found.</td></tr>
				}
				for _, h := range holds {
					<tr class="hover:bg-gray-50">
						<td class="px-4 py-2 text-gray-500">{ h.CreatedAt }</td>
						<td class="px-4 py-2">{ h.ProductName } · { h.Sku }</td>
						<td class="px-4 py-2 text-gray-500">{ h.LocationName }</td>
						<td class="px-4 py-2 text-right">{ fmt.Sprint(h.Quantity) }</td>
						<td class="px-4 py-2 text-gray-500">{ string(h.Source) }</td>
						<td class="px-4 py-2">
							@components.Badge(string(h.Status), holdBadgeTone(string(h.Status)))
						</td>
						<td class="px-4 py-2 text-gray-500">{ format.NullString(h.ExpiresAt) }</td>
						<td class="px-4 py-2 text-right">
							if h.Status == "active" {
								<form method="post" action={ "/holds/" + fmt.Sprint(h.ID) + "/release" }>
									<input type="hidden" name="csrf_token" value={ csrf }/>
									<button type="submit" class="text-sm text-gray-600 hover:text-gray-900">Release</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		}
	}
}

func holdBadgeTone(status string) string {
	switch status {
	case "active":
		return "info"
	case "consumed":
		return "success"
	case "expired":
		return "warning"
	case "released":
		return "neutral"
	default:
		return "neutral"
	}
}

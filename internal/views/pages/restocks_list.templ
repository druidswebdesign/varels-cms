package pages

import (
	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
	"github.com/druidswebdesign/varels-cms/internal/views/partials"
)

// RestockList renders the incoming-stock history.
templ RestockList(movements []sqlc.StockMovement, skus map[int64]string, locations map[int64]string, csrf string) {
	@layouts.Base("Restocks", "restocks", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Restocks</h1>
			<a href="/stock-movements" class="text-sm text-muted-foreground hover:text-foreground">Full ledger</a>
		</div>
		@components.Table() {
			<thead class="bg-muted">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">When</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Variant</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Location</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">State</th>
					<th class="px-4 py-2 text-right font-medium text-muted-foreground">Qty</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Ref</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Note</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				if len(movements) == 0 {
					<tr><td colspan="7" class="px-4 py-8 text-center text-muted-foreground">No restocks yet.</td></tr>
				}
				for _, m := range movements {
					@partials.RestockRow(m, skus[m.VariantID], locations[m.LocationID])
				}
			</tbody>
		}
	}
}

package pages

import (
	"fmt"

	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/components"
	"github.com/druidswebdesign/varels-cms/internal/views/format"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
)

// Collections lists drops / seasons / essentials and offers the create form.
templ Collections(collections []sqlc.Collection, csrf string) {
	@layouts.Base("Collections", "collections", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Collections</h1>
		</div>

		<form method="post" action="/collections"
			class="mb-6 flex flex-wrap items-end gap-3 rounded-lg border border-border bg-card p-4">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div>
				<label for="name" class="mb-1 block text-xs font-medium text-muted-foreground">Name</label>
				<input id="name" name="name" type="text" required class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="kind" class="mb-1 block text-xs font-medium text-muted-foreground">Kind</label>
				<select id="kind" name="kind" class="rounded-md border border-input px-3 py-2 text-sm">
					<option value="drop">drop</option>
					<option value="season">season</option>
					<option value="essentials">essentials</option>
				</select>
			</div>
			<div>
				<label for="season" class="mb-1 block text-xs font-medium text-muted-foreground">Season</label>
				<input id="season" name="season" type="text" class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="launch_date" class="mb-1 block text-xs font-medium text-muted-foreground">Launch date</label>
				<input id="launch_date" name="launch_date" type="date" class="rounded-md border border-input px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Create</button>
		</form>

		@components.Table() {
			<thead class="bg-muted">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Name</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Kind</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Season</th>
					<th class="px-4 py-2 text-left font-medium text-muted-foreground">Launch</th>
					<th class="px-4 py-2"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-border">
				if len(collections) == 0 {
					<tr><td colspan="5" class="px-4 py-8 text-center text-muted-foreground">No collections yet.</td></tr>
				}
				for _, c := range collections {
					<tr class="hover:bg-accent">
						<td class="px-4 py-2 font-medium text-foreground">{ c.Name }</td>
						<td class="px-4 py-2">
							@components.Badge(string(c.Kind), "info")
						</td>
						<td class="px-4 py-2 text-muted-foreground">{ format.NullString(c.Season) }</td>
						<td class="px-4 py-2 text-muted-foreground">{ format.NullString(c.LaunchDate) }</td>
						<td class="px-4 py-2 text-right">
							<form method="post" action={ "/collections/" + fmt.Sprint(c.ID) + "/archive" }>
								<input type="hidden" name="csrf_token" value={ csrf }/>
								<button type="submit" class="text-sm text-destructive hover:text-destructive/80">Archive</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		}
	}
}

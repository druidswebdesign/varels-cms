package pages

import (
	"fmt"

	"github.com/yourname/varels_cms/internal/db/sqlc"
	"github.com/yourname/varels_cms/internal/views/components"
	"github.com/yourname/varels_cms/internal/views/format"
	"github.com/yourname/varels_cms/internal/views/layouts"
)

// PurchaseOrders lists POs and offers the create form.
templ PurchaseOrders(orders []sqlc.PurchaseOrder, suppliers []sqlc.Supplier, locations []sqlc.Location, csrf string) {
	@layouts.Base("Purchase orders", "suppliers", csrf) {
		<div class="mb-4 flex items-center justify-between">
			<h1 class="text-xl font-semibold">Purchase orders</h1>
			<a href="/suppliers" class="text-sm text-gray-500 hover:text-gray-700">Suppliers</a>
		</div>

		<form method="post" action="/purchase-orders"
			class="mb-4 flex flex-wrap items-end gap-3 rounded-lg border border-gray-200 bg-white p-4">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<div>
				<label for="supplier_id" class="mb-1 block text-xs font-medium text-gray-600">Supplier</label>
				<select id="supplier_id" name="supplier_id" required class="rounded-md border border-gray-300 px-3 py-2 text-sm">
					for _, sup := range suppliers {
						<option value={ fmt.Sprint(sup.ID) }>{ sup.Name }</option>
					}
				</select>
			</div>
			<div>
				<label for="location_id" class="mb-1 block text-xs font-medium text-gray-600">Receive location</label>
				<select id="location_id" name="location_id" required class="rounded-md border border-gray-300 px-3 py-2 text-sm">
					for _, l := range locations {
						<option value={ fmt.Sprint(l.ID) }>{ l.Name }</option>
					}
				</select>
			</div>
			<div>
				<label for="expected_at" class="mb-1 block text-xs font-medium text-gray-600">Expected</label>
				<input id="expected_at" name="expected_at" type="date" class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<div>
				<label for="notes" class="mb-1 block text-xs font-medium text-gray-600">Notes</label>
				<input id="notes" name="notes" type="text" class="rounded-md border border-gray-300 px-3 py-2 text-sm"/>
			</div>
			<button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">New PO</button>
		</form>

		@components.Table() {
			<thead class="bg-gray-50">
				<tr>
					<th class="px-4 py-2 text-left font-medium text-gray-500">PO</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Supplier</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Location</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Status</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Expected</th>
					<th class="px-4 py-2 text-left font-medium text-gray-500">Created</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-100">
				if len(orders) == 0 {
					<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No purchase orders yet.</td></tr>
				}
				for _, po := range orders {
					<tr class="hover:bg-gray-50">
						<td class="px-4 py-2 font-medium">
							<a href={ "/purchase-orders/" + fmt.Sprint(po.ID) } class="text-blue-600 hover:underline">PO-{ fmt.Sprint(po.ID) }</a>
						</td>
						<td class="px-4 py-2">{ supplierName(suppliers, po.SupplierID) }</td>
						<td class="px-4 py-2 text-gray-500">{ locationNameOf(locations, po.LocationID) }</td>
						<td class="px-4 py-2">
							@components.Badge(string(po.Status), poBadgeTone(string(po.Status)))
						</td>
						<td class="px-4 py-2 text-gray-500">{ format.NullString(po.ExpectedAt) }</td>
						<td class="px-4 py-2 text-gray-500">{ po.CreatedAt }</td>
					</tr>
				}
			</tbody>
		}
	}
}

func supplierName(suppliers []sqlc.Supplier, id int64) string {
	for _, s := range suppliers {
		if s.ID == id {
			return s.Name
		}
	}
	return fmt.Sprint(id)
}

func locationNameOf(locations []sqlc.Location, id int64) string {
	for _, l := range locations {
		if l.ID == id {
			return l.Name
		}
	}
	return fmt.Sprint(id)
}

func poBadgeTone(status string) string {
	switch status {
	case "received":
		return "success"
	case "cancelled":
		return "danger"
	case "partial":
		return "warning"
	case "ordered":
		return "info"
	default:
		return "neutral"
	}
}

package pages

import (
	"fmt"

	"github.com/yourname/varels_cms/internal/views/layouts"
)

// Dashboard is the landing page. Low-stock and P&L load via HTMX so the shell
// renders immediately.
templ Dashboard(productCount int64, variantCount int64, isAdmin bool, csrf string) {
	@layouts.Base("Dashboard", "dashboard", csrf) {
		<h1 class="mb-4 text-xl font-semibold">Dashboard</h1>

		<div class="grid gap-4 sm:grid-cols-3">
			@statCard("Products", fmt.Sprint(productCount))
			@statCard("Variants", fmt.Sprint(variantCount))
			@statCard("Sales", "New sale →")
		</div>

		if isAdmin {
			<div id="profit-cards" hx-get="/dashboard/profit-cards" hx-trigger="load" hx-swap="outerHTML"
				class="mt-6 grid gap-4 sm:grid-cols-3"></div>
		}

		<div class="mt-6 grid gap-4 lg:grid-cols-2">
			<div id="low-stock" hx-get="/dashboard/low-stock" hx-trigger="load" hx-swap="outerHTML"
				class="rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-500">Loading low stock…</div>
			<div class="rounded-lg border border-gray-200 bg-white p-4">
				<h2 class="mb-2 text-sm font-medium text-gray-700">Shortcuts</h2>
				<ul class="space-y-1 text-sm">
					<li><a href="/sales/new" class="text-blue-600 hover:underline">New sale (POS)</a></li>
					<li><a href="/products" class="text-blue-600 hover:underline">Products</a></li>
					<li><a href="/stock-movements" class="text-blue-600 hover:underline">Stock movements</a></li>
					<li><a href="/analytics" class="text-blue-600 hover:underline">Analytics</a></li>
					<li><a href="/deadstock" class="text-blue-600 hover:underline">Deadstock</a></li>
				</ul>
			</div>
		</div>
	}
}

templ statCard(label string, value string) {
	<div class="rounded-lg border border-gray-200 bg-white p-4">
		<p class="text-sm text-gray-500">{ label }</p>
		<p class="mt-1 text-2xl font-semibold text-gray-900">{ value }</p>
	</div>
}

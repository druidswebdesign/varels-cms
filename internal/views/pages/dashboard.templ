package pages

import (
	"fmt"

	"github.com/yourname/varels_cms/internal/views/components"
	"github.com/yourname/varels_cms/internal/views/layouts"
)

// Dashboard is the landing page. Low-stock and P&L load via HTMX so the shell
// renders immediately.
templ Dashboard(productCount int64, variantCount int64, isAdmin bool, csrf string) {
	@layouts.Base("Dashboard", "dashboard", csrf) {
		<div class="space-y-1">
			<h2 class="text-2xl font-semibold tracking-tight">Dashboard</h2>
			<p class="text-sm text-muted-foreground">Inventory and profit at a glance.</p>
		</div>

		<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			@components.StatCard("Products", fmt.Sprint(productCount), "neutral")
			@components.StatCard("Active variants", fmt.Sprint(variantCount), "neutral")
			<a href="/sales/new" class="rounded-xl border bg-card p-6 text-card-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
				<p class="text-sm font-medium text-muted-foreground">Point of sale</p>
				<p class="mt-2 flex items-center gap-1 text-2xl font-semibold tracking-tight">
					New sale
					@components.Icon("arrow-up-right", "h-5 w-5")
				</p>
			</a>
			@components.StatCard("Quick actions", "Restock · Adjust", "neutral")
		</div>

		if isAdmin {
			<div id="profit-cards" hx-get="/dashboard/profit-cards" hx-trigger="load" hx-swap="outerHTML"
				class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				@components.StatCard("Revenue", "…", "neutral")
				@components.StatCard("Gross profit", "…", "neutral")
				@components.StatCard("Net profit", "…", "neutral")
			</div>
		}

		<div class="mt-4 grid gap-4 lg:grid-cols-2">
			<div id="low-stock" hx-get="/dashboard/low-stock" hx-trigger="load" hx-swap="outerHTML">
				@components.Card() {
					@components.CardHeader() {
						@components.CardTitle() { Low stock }
					}
					@components.CardContent() {
						<p class="text-sm text-muted-foreground">Loading low stock…</p>
					}
				}
			</div>
			@components.Card() {
				@components.CardHeader() {
					@components.CardTitle() { Shortcuts }
					@components.CardDescription() { Jump to common tasks }
				}
				@components.CardContent() {
					<div class="space-y-1">
						@shortcut("/sales/new", "New sale (POS)", "cart")
						@shortcut("/products", "Products", "package")
						@shortcut("/stock-movements", "Stock movements", "layers")
						@shortcut("/analytics", "Analytics", "chart")
						@shortcut("/deadstock", "Deadstock", "trending-down")
					</div>
				}
			}
		</div>
	}
}

templ shortcut(href string, label string, icon string) {
	<a href={ href } class="flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-accent hover:text-accent-foreground">
		@components.Icon(icon, "h-4 w-4 text-muted-foreground")
		<span class="flex-1">{ label }</span>
		@components.Icon("chevron-right", "h-4 w-4 text-muted-foreground")
	</a>
}

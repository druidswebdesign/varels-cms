package pages

import (
	"github.com/druidswebdesign/varels-cms/internal/db/sqlc"
	"github.com/druidswebdesign/varels-cms/internal/views/layouts"
	"github.com/druidswebdesign/varels-cms/internal/views/partials"
)

// RestockForm receives stock and offers the manual adjustment form as well. The
// forms post via HTMX and swap #restock-panel in place; the whole page degrades
// to a normal form post + redirect without JavaScript.
templ RestockForm(v sqlc.ProductVariant, productName string, stock []sqlc.StockLevel, locationNames map[int64]string, locations []sqlc.Location, reasonCodes []sqlc.ReasonCode, csrf string) {
	@layouts.Base("Restock", "restocks", csrf) {
		<div class="space-y-1">
			<h2 class="text-2xl font-semibold tracking-tight">Restock</h2>
			<p class="text-sm text-muted-foreground">{ productName }</p>
		</div>
		<div class="mt-6">
			@partials.RestockPanel(v, stock, locationNames, locations, reasonCodes, csrf)
		</div>
	}
}

PORT=8080
DB_PATH=./data/app.db
APP_ENV=development
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# Google OAuth (Goth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# First-run admin bootstrap (Google OAuth admin, created when the whitelist is empty)
INITIAL_OWNER_EMAIL=owner@clothingbrand.com

# Break-glass local admin (hidden /admin-login). Optional; set a strong password.
# Created/refreshed on startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

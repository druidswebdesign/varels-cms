PORT=8080
DB_PATH=./data/app.db
APP_ENV=development
# Required in production (>=32 bytes, e.g. `openssl rand -hex 32`). Optional in development.
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# First admin (email + bcrypt). Required on a fresh database; there is no
# public signup and Google OAuth sign-in is disabled. Set a strong password
# (>=12 characters; enforced in production). Created/refreshed on startup.
ADMIN_EMAIL=owner@clothingbrand.com
ADMIN_PASSWORD=

# Scheduled SQLite snapshots (VACUUM INTO) with retention.
# Defaults to <DB dir>/backups, every 24h, keeping the newest 7.
# BACKUP_DIR=./data/backups
# BACKUP_INTERVAL=24h
# BACKUP_RETENTION=7
